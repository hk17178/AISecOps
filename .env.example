# 复制为 .env 后填真实值（.env 已 gitignore，不入库 —— 见 O4 / CONSTRAINTS C-9）
# 凭证零硬编码：所有密码/Key 走 .env，代码用 pydantic-settings 读取。

# ---- PostgreSQL ----
POSTGRES_USER=aisecops
POSTGRES_PASSWORD=change_me_strong_password
POSTGRES_DB=aisecops
POSTGRES_PORT=5432

# ---- Redis ----
REDIS_PORT=6379

# ---- Grafana（可观测 profile）----
GRAFANA_PASSWORD=admin

# ---- LLM Provider（L05 Gateway，OpenAI 兼容接入）----
# 留空 LLM_API_KEY 则走 stub（不联网）。填了即调真实 LLM。
LLM_API_KEY=
# base_url + model 按你用的厂商填（都走 /v1/chat/completions 兼容端点）：
#   本地 Ollama : LLM_BASE_URL=http://localhost:11434/v1   LLM_MODEL=qwen2.5
#   DeepSeek    : LLM_BASE_URL=https://api.deepseek.com/v1  LLM_MODEL=deepseek-chat
#   通义(百炼)  : LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1  LLM_MODEL=qwen-plus
#   智谱        : LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4  LLM_MODEL=glm-4
#   豆包(方舟)  : LLM_BASE_URL=https://ark.cn-beijing.volces.com/api/v3  LLM_MODEL=<接入点ID>
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=qwen2.5
LLM_PRICE_PER_1K_CNY=0.0

# ---- 预算 / 出域 ----
MONTHLY_BUDGET_CNY=500
ALLOW_OUTBOUND=false

# ---- 通知（首个=企业微信，见 ADR-0010）----
# 企微群机器人 webhook（群设置 → 添加机器人 → 复制 webhook）
WECHAT_WEBHOOK=

# ---- 数据源（日志=ES 8.x，见 ADR-0009）----
ES_HOSTS=http://localhost:9200
ES_API_KEY=
# 或用户名密码：ES_USERNAME= / ES_PASSWORD=

# ---- 持久化（P-18；留空=内存重启丢，填=PG 持久化）----
# 本地 Colima PG（make dev 起的）示例：
# DATABASE_URL=postgresql://aisecops:change_me_in_env@localhost:5432/aisecops
DATABASE_URL=
